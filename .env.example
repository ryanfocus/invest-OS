# 複製此檔為 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。
#
# ⚠️ 這裡面是可以直接下單的期貨帳密。不要貼給任何人、不要放進聊天視窗、
#    不要放在會被同步到雲端的資料夾。

# 群益登入帳號（身分證字號）
CAPITAL_USER_ID=

# 群益登入密碼
CAPITAL_PASSWORD=

# 期貨帳號：分公司代碼 4 碼 + 帳號 7 碼，共 11 碼
# 登入後會由 OnAccount 事件回傳，第一次可留空、用 verify_login.py 查出來再填
CAPITAL_FUTURES_ACCOUNT=

# Discord webhook（訊號發報用）
DISCORD_WEBHOOK_URL=
